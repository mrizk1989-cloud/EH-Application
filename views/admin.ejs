<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>


    <link id="themeStylesheet" rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

    <nav class="navbar">
        <div id="logo">
            <img id="logo-svg" src="/imgs/logo/Imdad logo light.svg" alt="Imdad Logo" class="logo">
            <h2>Admin Panel</h2>
        </div>


        <div class="nav-links">

            <button data-section="users">Users</button>
            <button data-section="requests">Requests</button>
            <button data-section="export">Data Managment</button>
            <button data-section="eh-policy">Policy</button>


            <!-- SETTINGS DROPDOWN -->
            <div class="dropdown" id="settingsDropdown">

                <button class="dropdown-btn" id="dropdownBtn" type="button">
                    Settings ▼
                </button>

                <div class="dropdown-menu" id="dropdownMenu">
                    <div class="dropdown-item" data-value="rates">Exchange Rates</div>
                    <div class="dropdown-item" data-value="currencies">Currencies</div>
                    <div class="dropdown-item" data-value="expenseTypes">Expense Types</div>

                </div>

            </div>

            <button id="themeToggleBtn">Dark</button>

            <button id="logoutBtn">Logout</button>

        </div>

    </nav>

    <main>

        <section id="welcomeSection" class="section active">
            <div class="welcome-box">
                <h1>Welcome Admin 👑</h1>
            </div>
        </section>

        <section id="exportSection" class="section">
            <h3>Export Data From:</h3>
            <!-- <div id="exportContainer"></div> -->
            <div id="exportContainer" class="hidden"></div>
            <hr style="margin:50px 0;">
            <h3>Import Data To:</h3>
            <div id="importContainer"></div>
        </section>

        <section id="usersSection" class="section">
            <h3>Users</h3>
            <table>
                <thead id="usersTableHead">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Type</th>
                        <th>Roles</th>
                        <th>Country</th>
                        <th>Area</th>
                        <th>Status</th>
                        <th>Passowrd</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody"></tbody>
            </table>
        </section>

        <section id="requestsSection" class="section">
            <h3>Requests (Master + Sub Items)</h3>
            <div class="request-filters">

                <!-- USER -->
                <select id="filterUser">
                
                </select>


                <!-- YEAR -->
                <select id="filterYear">
                
                </select>

                <!-- STATUS -->
                <select id="filterStatus">
               
                </select>

                <!-- CURRENT ROLE -->
                <select id="filterRole">
             
                </select>

                <!-- SEARCH BUTTON -->
                <button id="searchRequestsBtn">
                    Search
                </button>

            </div>

            <table>
                <thead>
                    <tr>
                        <th>Request Number</th>
                        <th>Requested By</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Current Role</th>
                        <th>Attachments</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="requestsTableBody"></tbody>
            </table>
        </section>

        <section id="eh-policySection" class="section">
            <div id="ehPolicyContainer"></div>
        </section>

        <section id="settingsSection" class="section">
            <h3 id="settingsTitle">Settings</h3>
            <div id="settingsTableWrapper"></div>
        </section>

    </main>

    <script type="module" src="/js/admin.js"></script>

</body>

</html>