<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>User Dashboard</title>

    <!-- <link rel="stylesheet" href="/css/userHome.css"> -->
    <link id="themeStylesheet" rel="stylesheet" href="/css/userHome.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <div class="navbar">
        <div id="logo">
            <img id="logo-svg" src="/imgs/logo/Imdad logo light.svg" alt="Imdad Logo" class="logo">
            <div class="nav-left">
                Welcome, <span id="userName">User</span>
            </div>
        </div>


        <div class="nav-right">
            <button id="newRequestBtn">+ New Request</button>
            <button data-tab="requests">Requests</button>
            <button data-tab="dashboard">Dashboard</button>
            <button data-tab="policies">Policy</button>
            <button id="changePasswordBtn">Change Password</button>
            <button id="themeToggleBtn">Dark</button>
            <button id="logoutBtn">Logout</button>
        </div>
    </div>

    <!-- ================= MAIN ================= -->
    <div id="exportContainer"></div>
    <div class="container">
        <h2>Your Requests</h2>
        <!-- REQUESTS VIEW -->
        <div id="requestsView">
            <div id="requestModeContainer" class="request-mode-buttons hidden">

                <button id="assignedRequestsBtn" class="active-view-btn">
                    Assigned Requests
                </button>

                <button id="allRequestsBtn">
                    All Requests
                </button>

            </div>
            <div class="request-filters">

                <!-- YEAR -->
                <select id="filterYear"></select>

                <!-- STATUS -->
                <select id="filterStatus"></select>

                <!-- CURRENT ROLE -->
                <select id="filterRole"></select>

                <!-- REQUESTER -->
                <select id="filterRequester">
                    <option value="">All Requesters</option>
                </select>

                <!-- AREA -->
                <select id="filterArea">
                    <option value="">All Areas</option>
                </select>

                <!-- SEARCH BUTTON -->
                <button id="searchRequestsBtn">Search</button>

            </div>
            <div id="requestsWrapper">
                <!-- Requests will load here -->
            </div>
        </div>
        <div id="dashboardContainer" class="hidden"></div>
        <div id="policiesContainer" class="hidden"></div>
        <div id="passwordModal" class="modal hidden">
            <div class="modal-content">
                <h3>Change Password</h3>
                <div class="password-current-wrapper">
                    <input type="password" id="currentPassword" placeholder="Current Password">
                    <span class="toggle-eye-current" data-target="currentPassword">👁</span>
                </div>
                <div class="password-new-wrapper">
                    <input type="password" id="newPassword" placeholder="New Password">
                    <span class="toggle-eye-new" data-target="newPassword">👁</span>
                </div>
                <button id="savePasswordBtn">Save</button>
                <button id="closeModalBtn">Cancel</button>
            </div>
        </div>
    </div>



    <script type="module" src="/js/userHome.js"></script>
</body>

</html>